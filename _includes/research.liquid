{% if site.data.research and site.data.research.entries.size > 0 %}
  <div class="publications">
    <h2 class="research-heading">Research</h2>
    {% assign research_intro = include.intro | default: site.data.research.intro | strip %}
    {% if research_intro != "" %}
      <div class="research-intro">{{ research_intro | markdownify }}</div>
    {% endif %}
    <h2 class="publications-heading">Publications</h2>
    <ol class="bibliography">
      {% for item in site.data.research.entries %}
        <li>
          <div class="row align-items-center">
            {% if item.image %}
              <div class="col-md-4 col-sm-12 abbr">
                {%
                  include figure.liquid
                  loading="eager"
                  path=item.image
                  sizes="(min-width: 768px) 280px, 95vw"
                  class="preview z-depth-1 rounded"
                  zoomable=true
                  avoid_scaling=true
                  alt=item.title
                %}
              </div>
            {% endif %}
            <div class="{% if item.image %}col-md-8{% else %}col-md-12{% endif %} col-sm-12">
              <div class="title">
                {% if item.url %}
                  <a href="{{ item.url }}">{{ item.title }}</a>
                {% else %}
                  {{ item.title }}
                {% endif %}
              </div>
              {% if item.authors %}
                <div class="author">{{ item.authors }}</div>
              {% endif %}
              {% if item.venue %}
                <div class="periodical">
                  <em>{{ item.venue }}</em>
                  {% if item.venue_highlight %}
                    <span class="research-venue-highlight">{{ item.venue_highlight }}</span>
                  {% endif %}
                </div>
              {% endif %}
              <div class="research-links">
                {% if item.links and item.links.size > 0 %}
                  {% for link in item.links %}
                    {% unless forloop.first %}&nbsp;|&nbsp;{% endunless %}
                    <a href="{{ link.url }}">{{ link.label }}</a>
                  {% endfor %}
                {% endif %}
                {% if item.tldr %}
                  {% if item.links and item.links.size > 0 %}&nbsp;|&nbsp;{% endif %}
                  <span class="research-tldr">
                    <input type="checkbox" id="tldr-{{ forloop.index }}" class="research-tldr-toggle">
                    <label for="tldr-{{ forloop.index }}" class="research-tldr-label">TLDR</label>
                    <span class="research-tldr-body">{{ item.tldr }}</span>
                  </span>
                {% endif %}
              </div>
            </div>
          </div>
        </li>
      {% endfor %}
    </ol>
  </div>
{% endif %}
